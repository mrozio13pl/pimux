{
    "name": "pimux",
    "version": "0.5.1",
    "private": true,
    "description": "boring terminal multiplexer",
    "author": "mrozio13pl",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "lint": "oxlint .",
        "format": "oxfmt --write",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test tests/*.test.mjs",
        "test:pi-extension": "node --experimental-strip-types --test tests/pi-extension.test.mjs",
        "test:settings": "node --experimental-strip-types --test tests/settings.test.mjs",
        "preview": "vite preview",
        "tauri": "tauri"
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@fontsource-variable/space-grotesk": "^5.3.0",
        "@lobehub/icons": "^5.14.0",
        "@phosphor-icons/react": "^2.1.10",
        "@pierre/trees": "1.0.0-beta.5",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-hotkeys": "0.10.0",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.2",
        "@tauri-apps/plugin-store": "^2.4.4",
        "ansis": "^4.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "ghostty-web": "^0.4.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "shadcn": "^4.14.1",
        "snarkdown": "^2.0.0",
        "strip-ansi": "^7.2.0",
        "swr": "^2.4.2",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@earendil-works/pi-ai": "^0.82.0",
        "@earendil-works/pi-coding-agent": "^0.82.0",
        "@earendil-works/pi-tui": "^0.82.0",
        "@tauri-apps/cli": "^2.11.4",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "nano-staged": "^1.0.2",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "~7.0.2",
        "vite": "^8.1.5"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "simple-git-hooks": {
        "commit-msg": "pnpm exec commitlint --edit $1",
        "pre-commit": "pnpm exec nano-staged"
    },
    "nano-staged": {
        "*.{js,jsx,ts,tsx,mjs,cjs}": [
            "oxfmt",
            "oxlint --fix"
        ],
        "*.{json,jsonc,md,yml,yaml,css,html}": [
            "oxfmt"
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ],
        "rules": {
            "type-enum": [
                2,
                "always",
                [
                    "build",
                    "chore",
                    "ci",
                    "docs",
                    "feat",
                    "fix",
                    "improve",
                    "improvement",
                    "perf",
                    "refactor",
                    "revert",
                    "style",
                    "test"
                ]
            ]
        }
    },
    "packageManager": "pnpm@11.19.0"
}
