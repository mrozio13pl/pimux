---
const repo = 'https://github.com/mrozio13pl/pimux';
const latest = `${repo}/releases/latest`;
---

<section class="get border-t border-white/8 px-6 py-24 text-center sm:px-10 lg:py-32">
    <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="40" height="40" class="mx-auto" />

    <h2 class="font-heading mt-6 text-3xl leading-tight font-bold tracking-tight sm:text-4xl">
        get pimux
    </h2>
    <p class="mt-3 text-base text-steel">free, open source, and really boring.</p>

    <a
        href={latest}
        data-download
        class="bg-sand hover:bg-sand-dim focus-visible:outline-sand mt-8 inline-flex items-center rounded-lg px-5 py-2.5 font-mono text-sm font-medium text-black transition-colors focus-visible:outline-2 focus-visible:outline-offset-3"
    >
        download
    </a>
</section>
