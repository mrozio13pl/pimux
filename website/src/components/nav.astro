---
import { version } from '../../../package.json'

const repo = 'https://github.com/mrozio13pl/pimux';
---

<header class="sticky top-0 z-20 flex items-center justify-between gap-4 border-b border-white/8 bg-background/70 px-5 py-3 backdrop-blur-xl sm:px-8">
    <a href={import.meta.env.BASE_URL} class="group flex items-center gap-2.5 rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sand">
        <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" width="30" height="30" class="transition-transform duration-500 group-hover:rotate-45" />
        <span class="font-heading text-xl font-bold tracking-tight">pimux</span>
    </a>

    <nav class="flex items-center gap-1 font-mono text-xs">
        <a
            href={`${repo}/releases`}
            class="rounded-md px-2.5 py-1.5 text-steel transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand"
        >v{version}</a>
        <a
            href={repo}
            class="rounded-md px-2.5 py-1.5 text-steel transition-colors hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sand"
        >github</a>
    </nav>
</header>
